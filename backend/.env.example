# CareerAI 本地开发环境变量模板（复制为 .env 使用）
# PostgreSQL（Docker: docker compose up -d）
DATABASE_URL=postgresql+asyncpg://careerai:careerai@localhost:5432/careerai
# Redis（Celery broker + 缓存；compose 映射到宿主机 6380）
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
# JWT 签名密钥（HS256）
# 开发占位值（≥32 字节，消除 PyJWT InsecureKeyLengthWarning；仅本地开发使用）
# 生产环境必须注入 ≥32 字节随机密钥，禁止默认占位值上线：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me-please-generate-a-real-random-secret-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 密码强度
PASSWORD_MIN_LENGTH=8
# 调试
DEBUG=false
# DeepSeek API（AI 报告生成核心依赖；生产使用独立 key）
DEEPSEEK_API_KEY=$YOUR_DEEPSEEK_API_KEY
AI_WATCHDOG_SECONDS=300
DEEPSEEK_TIMEOUT_SECONDS=60
# GLM 视觉（图片/扫描件简历 OCR；不配置则图片/扫描件解析失败并引导手动补填）
GLM_API_KEY=$YOUR_GLM_API_KEY
GLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_VISION_MODEL=glm-4.6v-flash
GLM_VISION_TIMEOUT_SECONDS=60
GLM_VISION_MAX_RETRIES=3
# RAG Rerank（本地交叉编码器重排；可选增强，失败自动降级 RRF 原序）
# 默认开启本地 bge-reranker-v2-m3（权重走 HF 缓存快照，同 bge-m3 离线加载，零 API 成本）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_PATH=
RERANK_DEVICE=cpu
RERANK_CANDIDATE_POOL=40
RERANK_TIMEOUT_SECONDS=5
# 如选用云端 Rerank API（Jina/Cohere 等，需用户授权付费）：填写 API key 并改 RERANK_MODEL 为 API 标识
RERANK_API_KEY=change-me
